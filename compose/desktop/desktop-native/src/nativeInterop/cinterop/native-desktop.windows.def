headers = native_desktop.h native_tray.h native_drag.h native_gl.h
headerFilter = native_desktop.h native_tray.h native_drag.h native_gl.h
package = nativedesktop
compilerOpts = -D_WIN32_WINNT=0x0A00 -DUNICODE -D_UNICODE
linkerOpts = -Lbuild/windows-sdl/SDL3-3.4.10/x86_64-w64-mingw32/lib -lSDL3 -lopengl32 -ldwmapi -lole32 -lshell32 -luuid -luser32 -lgdi32 -lstdc++
